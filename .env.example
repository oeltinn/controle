# Copy to `.env.local` for local development. These are public browser settings.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
VITE_VAPID_PUBLIC_KEY=replace_with_public_web_push_key

# Server only. Configure these in Vercel; never prefix them with VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_secret_key
VAPID_PRIVATE_KEY=replace_with_private_web_push_key
